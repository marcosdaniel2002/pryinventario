# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:1234@localhost:5432/stockhub?schema=public"

JWT_SECRET=stockhub-dev-secret-change-me
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000

# Carpeta en disco donde se guardan las fotos de producto (campo "foto").
# Opcional: si no se define, usa ./media/producto relativo a la raíz del proyecto.
# PRODUCTO_FOTOS_DIR=./media/producto

# Igual que arriba, pero para el segundo campo de foto ("foto_2").
# PRODUCTO_FOTOS_2_DIR=./media/producto-2

# Carpeta en disco donde se guarda el icono de la configuración de la página.
# Opcional: si no se define, usa ./media/configuracion.
# CONFIGURACION_ICONO_DIR=./media/configuracion

